# =============================================================================
# AXIO Clinical — .env.example (consolidado)
# Copiar a orchestration/.env y completar. NUNCA commitear el .env real.
# Generar secretos:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"                    # tokens
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"  # pepper/key
# =============================================================================

# --- Postgres del compose (host port 5433) ---
POSTGRES_USER=axio_clinical
POSTGRES_PASSWORD=

# --- Motor clínico ---
AXIO_CLINICAL_ENV=dev
AXIO_CLINICAL_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Dell (Arc 140V): qwen3:8b · Server 2x4080: qwen3:14b — único cambio al escalar hardware.
AXIO_CLINICAL_MODEL_REASONING=qwen3:8b
AXIO_CLINICAL_MODEL_TRIAGE=qwen3:8b
AXIO_CLINICAL_MODEL_EMBED=nomic-embed-text
AXIO_CLINICAL_LOCAL_TIMEOUT_S=60

# SoR: DSN al postgres del compose. Pepper y key (base64 de 32 bytes) son OBLIGATORIOS
# si hay DSN — el arranque falla a propósito sin ellos (fail-closed).
AXIO_CLINICAL_SOR_DSN=postgresql+psycopg://axio_clinical:<POSTGRES_PASSWORD>@postgres:5432/axio_clinical_motor
AXIO_CLINICAL_IDENTITY_PEPPER=
AXIO_CLINICAL_IDENTITY_KEY=

# Identidad servicio-a-servicio: "nombre:token,nombre:token". smoke.sh usa "smoke".
AXIO_CLINICAL_SERVICE_TOKENS=

# Crisis N3 → simulador local (orchestration/scripts/oncall_sim.py).
AXIO_CLINICAL_CRISIS_WEBHOOK_URL=http://oncall-sim:9999/crisis
AXIO_CLINICAL_CRISIS_WEBHOOK_TOKEN=

# Ingesta motor → consola. Debe ser IGUAL a MOTOR_INGEST_TOKEN.
AXIO_CLINICAL_CONSOLE_BASE_URL=http://consola-api:8000
AXIO_CLINICAL_CONSOLE_INGEST_TOKEN=

# --- Consola ---
JWT_SECRET=
MOTOR_INGEST_TOKEN=
# Lectura del hilo del motor: rol console_ro (solo SELECT). La contraseña debe coincidir
# con la de orchestration/scripts/initdb/02-console-ro.sql. La llave AES es AXIO_CLINICAL_IDENTITY_KEY.
MOTOR_DATABASE_URL=postgresql+asyncpg://console_ro:<password>@postgres:5432/axio_clinical_motor

# --- Vega (backend paciente, NestJS :4000) ---
# JWT del paciente y URL del motor (ajustar según el .env propio de Vega).
# VEGA_JWT_SECRET=
# VEGA_MOTOR_URL=http://localhost:8000
